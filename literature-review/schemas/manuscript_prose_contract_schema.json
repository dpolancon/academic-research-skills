{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ManuscriptProseContractSchema",
  "description": "Schema governing the transformation from Staged Prose to Publication Manuscript Prose.",
  "type": "object",
  "properties": {
    "unit_id": { "type": "string" },
    "staged_prose_ref": { "type": "string" },
    "manuscript_section": { "type": "string" },
    "target_register": {
      "type": "string",
      "description": "The specific disciplinary/venue register (e.g. Cambridge Journal of Economics, Top-5 Economics, Jacobin)."
    },
    "manuscript_paragraph": {
      "type": "string",
      "description": "The publication-ready prose text."
    },
    "sentence_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "manuscript_sentence_index": { "type": "integer" },
          "text": { "type": "string" },
          "source_staged_sentences": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Indices of staged sentences merged or adapted into this sentence."
          },
          "mapped_slot_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "transformation_class": {
            "type": "string",
            "enum": [
              "DIRECT_REFINEMENT",
              "SENTENCE_COMBINATION",
              "SYNTACTIC_COMPRESSION",
              "CADENCE_ADAPTATION",
              "RHETORICAL_CONNECTIVE"
            ]
          },
          "citations_embedded": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "manuscript_sentence_index",
          "text",
          "source_staged_sentences",
          "mapped_slot_ids",
          "transformation_class",
          "citations_embedded"
        ]
      }
    },
    "negative_invariants_verified": {
      "type": "object",
      "properties": {
        "zero_invented_claims": { "type": "boolean" },
        "zero_unauthorized_evidence": { "type": "boolean" },
        "zero_causal_strengthening": { "type": "boolean" },
        "qualifications_preserved": { "type": "boolean" },
        "source_ownership_intact": { "type": "boolean" },
        "zero_unearned_novelty": { "type": "boolean" },
        "contribution_hierarchy_preserved": { "type": "boolean" }
      },
      "required": [
        "zero_invented_claims",
        "zero_unauthorized_evidence",
        "zero_causal_strengthening",
        "qualifications_preserved",
        "source_ownership_intact",
        "zero_unearned_novelty",
        "contribution_hierarchy_preserved"
      ]
    },
    "human_status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "RATIFICATION_READY", "LOCK"]
    }
  },
  "required": [
    "unit_id",
    "staged_prose_ref",
    "manuscript_section",
    "target_register",
    "manuscript_paragraph",
    "sentence_mapping",
    "negative_invariants_verified",
    "human_status"
  ]
}
