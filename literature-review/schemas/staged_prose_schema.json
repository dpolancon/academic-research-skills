{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StagedProseSchema",
  "description": "Schema for Staged Academic Prose: restrained, inspectable prose stabilizing claim boundaries, order, and citations prior to manuscript styling.",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "Identifier for the argumentative unit (e.g., P01, UNIT_01)."
    },
    "assembly_ref": {
      "type": "string",
      "description": "Reference to governing Argument Assembly unit."
    },
    "ledger_ref": {
      "type": "string",
      "description": "Reference to governing Paragraph Ledger."
    },
    "staged_sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sentence_index": { "type": "integer", "minimum": 1 },
          "slot_id": { "type": "string", "description": "Mapped ledger slot ID (e.g. S1, P01.S2)." },
          "staged_text": { "type": "string", "description": "The restrained scholarly sentence." },
          "provenance_class": {
            "type": "string",
            "enum": [
              "DIRECT_SOURCE_CLAIM",
              "AUTHORIAL_SYNTHESIS",
              "ADJUDICATED_CROSS_LITERATURE_HINGE",
              "TRANSITION"
            ]
          },
          "attribution": {
            "type": "object",
            "properties": {
              "source_keys": { "type": "array", "items": { "type": "string" } },
              "citations": { "type": "array", "items": { "type": "string" } },
              "locators": { "type": "string" }
            },
            "required": ["source_keys", "citations"]
          },
          "qualification_notes": { "type": "string" },
          "boundary_enforcement": { "type": "string", "description": "How the sentence observes the prohibited stronger claim." }
        },
        "required": ["sentence_index", "slot_id", "staged_text", "provenance_class", "attribution", "boundary_enforcement"]
      }
    },
    "full_staged_paragraph": {
      "type": "string",
      "description": "The complete restrained staged paragraph assembled sequentially."
    },
    "inspection_checks": {
      "type": "object",
      "properties": {
        "plain_syntax_observed": { "type": "boolean" },
        "ornament_minimized": { "type": "boolean" },
        "signposting_restrained": { "type": "boolean" },
        "citations_stabilized": { "type": "boolean" },
        "boundaries_visible": { "type": "boolean" }
      },
      "required": [
        "plain_syntax_observed",
        "ornament_minimized",
        "signposting_restrained",
        "citations_stabilized",
        "boundaries_visible"
      ]
    },
    "human_status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "RATIFICATION_READY", "LOCK"]
    }
  },
  "required": [
    "unit_id",
    "assembly_ref",
    "ledger_ref",
    "staged_sentences",
    "full_staged_paragraph",
    "inspection_checks",
    "human_status"
  ]
}
