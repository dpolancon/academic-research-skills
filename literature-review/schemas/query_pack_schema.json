{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryPackObject",
  "type": "object",
  "properties": {
    "query_pack_id": { "type": "string", "pattern": "^QP_[A-Z0-9_]+$" },
    "title": { "type": "string" },
    "thematic_scope": { "type": "string" },
    "atomic_question_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^Q_[A-Z0-9_]+$" }
    },
    "target_tiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["TIER_A_CORE", "TIER_B_SUPPORTING", "TIER_C_CONTEXTUAL"]
      }
    }
  },
  "required": ["query_pack_id", "title", "thematic_scope", "atomic_question_ids"]
}
