# ==============================================================================
# Academic Research Skills (ARS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# --- LLM Providers & Credentials ---
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
GEMINI_API_KEY=

# --- Model Selection Defaults ---
DEFAULT_PROVIDER=together
DEFAULT_MODEL=Qwen/Qwen3.5-9B

# --- Academic API Credentials (Optional) ---
# Semantic Scholar API Key (for higher request rate limits)
S2_API_KEY=

# OpenAlex Polite Pool Email (faster response times and higher limits)
OPENALEX_POLITE_EMAIL=

# --- Pipeline Feature Flags (Optional: 0 = disabled, 1 = enabled) ---
# ARS_CROSS_MODEL=0
# ARS_CLAIM_AUDIT=0
# ARS_PASSPORT_RESET=0
# ARS_SOCRATIC_READING_PROBE=0
